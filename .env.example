NEXT_PUBLIC_SUPABASE_URL=https://axtvisukibxnhnyoffke.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Powers Genius leg of /api/genius (Compose, signature search). Apple/iTunes search works without this key.
# Set on Vercel Production AND Preview if you want Genius hits outside the Margo catalog in preview deploys.
GENIUS_API_KEY=your_genius_api_key_here

# Sentry (optional — omit locally to disable; set in Vercel Production + Preview)
# Org: margo-q2 — create a Next.js project in Sentry and paste the DSN here.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Optional: margo-q2 / project slug (for future source maps + releases; not required for errors-only)
SENTRY_ORG=margo-q2
SENTRY_PROJECT=
# Optional overrides — default: VERCEL_ENV or NODE_ENV
# SENTRY_ENVIRONMENT=production
# SENTRY_ENABLED=false
# SENTRY_DEBUG=true

# PostHog (optional — omit locally to disable; set in Vercel production)
# NEXT_PUBLIC_POSTHOG_KEY=phc_...
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# NEXT_PUBLIC_POSTHOG_UI_HOST=https://us.posthog.com

# Canonical site origin for promote OAuth redirect_uri (must match TikTok/Meta/Google app redirect URLs)
# PROMOTE_OAUTH_PUBLIC_ORIGIN=https://trymargo.com

# Auto-Promote (YouTube OAuth + encrypted token vault + R2 render staging)
GOOGLE_PROMOTE_CLIENT_ID=
GOOGLE_PROMOTE_CLIENT_SECRET=
FACEBOOK_PROMOTE_APP_ID=
FACEBOOK_PROMOTE_APP_SECRET=
# TikTok Login Kit — production app (live after App Review). Never commit real values.
TIKTOK_PROMOTE_CLIENT_KEY=
TIKTOK_PROMOTE_CLIENT_SECRET=
# Optional sandbox app for pre-review testing (separate TikTok portal app).
TIKTOK_SANDBOX_CLIENT_KEY=
TIKTOK_SANDBOX_CLIENT_SECRET=
# Which credential pair OAuth uses: production (default) or sandbox
# TIKTOK_PROMOTE_MODE=production
# Unaudited apps always post SELF_ONLY (ignored until audit). After App Review:
# TIKTOK_PROMOTE_APP_AUDITED=true
# TIKTOK_PROMOTE_PRIVACY_LEVEL=PUBLIC_TO_EVERYONE
# Video transfer: file_upload (default) or pull_from_url (requires verified audio.trymargo.com in TikTok portal)
# TIKTOK_PROMOTE_TRANSFER=file_upload
# 32-byte key, base64-encoded (openssl rand -base64 32)
PROMOTE_TOKEN_ENCRYPTION_KEY=
# Vercel Cron auth (Bearer token on /api/cron/promote-cleanup)
CRON_SECRET=
# Cloudflare R2 — same bucket as audio.trymargo.com (Margo/audio/*). Auto-Promote writes Margo/promote/*.
# Aliases: CLOUDFLARE_ACCOUNT_ID, CLOUDFLARE_R2_ACCESS_KEY_ID, CLOUDFLARE_R2_SECRET_ACCESS_KEY, CLOUDFLARE_R2_BUCKET_NAME
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=margo
# Optional; default 3600
# R2_SIGNED_URL_EXPIRY_SEC=3600
# Public CDN host for stable promote MP4 URLs (default audio.trymargo.com)
# MARGO_MEDIA_PUBLIC_HOST=audio.trymargo.com

